# demo: 브라우저 localStorage / live: 서버 DB (Vercel에도 설정 후 Redeploy)
NEXT_PUBLIC_MODE=demo

# Supabase 이전 검증 완료 후 live와 함께 supabase로 설정
STORAGE_PROVIDER=sheets
SUPABASE_URL=
# 서버 전용 service_role 또는 Supabase secret key. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=

# 신규 DB에 첫 관리자를 만들 때만 설정. 기존 사용자 이전 시 불필요.
SETUP_SECRET=

# 기존 Sheets 운영 / 데이터 이전 시에만 필요
GAS_URL=
GAS_SECRET=

# 선택: 도입 문의 이메일
NEXT_PUBLIC_CONTACT_EMAIL=
